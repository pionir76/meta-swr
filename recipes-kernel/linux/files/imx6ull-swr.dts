// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/*
 * SWR SmartRoute Gateway - i.MX6ULL custom board
 *
 * NXP i.MX6ULL 14x14 EVK 디바이스트리(imx6ul-14x14-evk.dtsi)에서 이 보드에
 * 실제로 있는 장치만 추려서 만든 전용 DTS. EVK dtsi를 include하지 않으므로
 * EVK에만 있는 LCD/터치/카메라/오디오/Wi-Fi/BT/HDMI 브리지/센서/CAN 노드는
 * 애초에 들어오지 않는다(SoC dtsi 기본값이 전부 disabled).
 *
 * 보드 구성 (docs/hardware.md 참고):
 *   - DDR 512MB, eMMC(uSDHC2), 외부 RTC RS5C372A(I2C1, 0x32)
 *   - Ethernet x2: FEC1 + FEC2 (PHY는 둘 다 FEC2의 MDIO 버스에 연결, EVK와 동일)
 *   - UART1: 디버그 콘솔(ttymxc0), UART2: RS485(ttymxc1)
 *   - LCD/터치/부저 없음 (헤드리스)
 *
 * 핀먹스/노드 내용은 EVK dtsi에서 그대로 가져온 것이라 EVK와 배선이 같은
 * 부분(이더넷, eMMC, UART, I2C1)은 그대로 동작하고, 아래 "확인 필요" 표시가
 * 있는 항목은 회로도 확인 후 손봐야 한다.
 */

/dts-v1/;

#include "imx6ull.dtsi"

/ {
	model = "SWR SmartRoute Gateway (i.MX6ULL)";
	compatible = "swr,smartroute-gateway", "fsl,imx6ull";

	chosen {
		stdout-path = &uart1;
	};

	/*
	 * RTC 번호 고정: 별칭이 없으면 프로브 순서에 따라 rtc0/rtc1이 바뀔 수
	 * 있다. 외부 RS5C372A를 rtc0으로 고정해 커널 hctosys/systohc 대상이
	 * 항상 배터리 백업 RTC가 되게 한다(SNVS RTC는 백업 전원이 없음).
	 */
	aliases {
		rtc0 = &ext_rtc;
		rtc1 = &snvs_rtc;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x20000000>;
	};

	/*
	 * EVK에서는 이 GPIO(GPIO5_IO02)가 주변장치(이더넷 PHY 포함) 3.3V
	 * 레귤레이터 enable이다. 이 보드에서 같은 배선인지 확인 필요 -
	 * EVK dtsi를 패치해 쓰던 기존 구성에서도 이 노드가 있었고 그 상태로
	 * 이더넷이 동작했으므로 일단 그대로 둔다. 보드에 해당 회로가 없다면
	 * 이 노드와 &fec1/&fec2의 phy-supply를 함께 지우면 된다.
	 */
	reg_peri_3v3: regulator-peri-3v3 {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_peri_3v3>;
		regulator-name = "VPERI_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio5 2 GPIO_ACTIVE_LOW>;
		regulator-always-on;
	};
};

&clks {
	assigned-clocks = <&clks IMX6UL_CLK_PLL3_PFD2>;
	assigned-clock-rates = <320000000>;
};

/*
 * Ethernet. 커널 netdev 이름은 프로브 순서(레지스터 주소 순)로 붙으므로
 * FEC2(20b4000) = eth0, FEC1(2188000) = eth1 이 된다. 네트워크 설정은 이름이
 * 아니라 udev ID_PATH(platform-2188000.ethernet 등)로 매칭한다
 * (recipes-core/swr-network-config 참고).
 *
 * 시제품 보드는 FEC1 쪽 PHY(주소 2)만 실장되어 있어 FEC2는 "Unable to
 * connect to phy"로 뜨지 않고, PHY 리셋 폴링 타임아웃 때문에 부팅이 약 40초
 * 늦어진다. 양산 보드에 FEC2 PHY(주소 1)가 실장되면 그대로 동작한다.
 */
&fec1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enet1>;
	phy-mode = "rmii";
	phy-handle = <&ethphy0>;
	phy-supply = <&reg_peri_3v3>;
	status = "okay";
};

&fec2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enet2>;
	phy-mode = "rmii";
	phy-handle = <&ethphy1>;
	phy-supply = <&reg_peri_3v3>;
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy0: ethernet-phy@2 {
			compatible = "ethernet-phy-id0022.1560";
			reg = <2>;
			micrel,led-mode = <1>;
			clocks = <&clks IMX6UL_CLK_ENET_REF>;
			clock-names = "rmii-ref";
		};

		ethphy1: ethernet-phy@1 {
			compatible = "ethernet-phy-id0022.1560";
			reg = <1>;
			micrel,led-mode = <1>;
			clocks = <&clks IMX6UL_CLK_ENET2_REF>;
			clock-names = "rmii-ref";
		};
	};
};

/* 외부 RTC (Ricoh RS5C372A) - Linux에서는 i2c-0 */
&i2c1 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c1>;
	status = "okay";

	ext_rtc: rtc@32 {
		compatible = "ricoh,rs5c372a";
		reg = <0x32>;
	};
};

/* 디버그 콘솔 (ttymxc0) */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

/*
 * RS485 (ttymxc1) - SmartRoute 앱이 Modbus RTU/ASCII, PCLink에 사용.
 * 확인 필요: 트랜시버가 자동 방향전환이면 아래 설정 그대로면 되고, RTS로
 * DE/RE를 제어해야 하면 `linux,rs485-enabled-at-boot-time;` 과
 * `rs485-rts-active-high;`(극성에 맞게)를 추가해야 한다. 기존 EVK 패치
 * 구성(RTS/CTS 핀 포함)에서 통신이 되고 있었으므로 그 설정을 유지한다.
 */
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart2>;
	uart-has-rtscts;
	status = "okay";
};

/*
 * eMMC (uSDHC2). 확인 필요: 보드가 DATA4~7까지 배선되어 있으면 EVK의
 * imx6ull-14x14-evk-emmc.dts처럼 pinctrl_usdhc2_8bit + bus-width = <8>로
 * 바꿔 성능을 올릴 수 있다. 확인 전까지는 EVK 기본(4bit) 구성을 유지한다.
 */
&usdhc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc2>;
	non-removable;
	keep-power-in-suspend;
	wakeup-source;
	status = "okay";
};

/*
 * 워치독/재부팅: OP-TEE(PSCI)가 없으므로 커널은 wdog1로 시스템을 재시작한다.
 * EVK의 fsl,ext-reset-output은 소프트웨어 재시작 시 외부 WDOG_B 핀(LCD_RESET
 * 패드)만 구동하는데 - EVK에서는 그 핀이 PMIC 리셋에 연결돼 있지만 이 보드는
 * 아니라서 `reboot`가 "Reboot failed -- System halted"로 멈추고 128초 워치독
 * 타임아웃으로만 재시작됐다(2026-10-13 실기기, meta-sdr100도 동일). 속성을
 * 빼서 SoC 내부 리셋을 쓰게 한다.
 */
&wdog1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_wdog>;
};

&snvs_poweroff {
	status = "okay";
};

&snvs_pwrkey {
	status = "okay";
};

&iomuxc {
	pinctrl-names = "default";

	pinctrl_enet1: enet1grp {
		fsl,pins = <
			MX6UL_PAD_ENET1_RX_EN__ENET1_RX_EN	0x1b0b0
			MX6UL_PAD_ENET1_RX_ER__ENET1_RX_ER	0x1b0b0
			MX6UL_PAD_ENET1_RX_DATA0__ENET1_RDATA00	0x1b0b0
			MX6UL_PAD_ENET1_RX_DATA1__ENET1_RDATA01	0x1b0b0
			MX6UL_PAD_ENET1_TX_EN__ENET1_TX_EN	0x1b0b0
			MX6UL_PAD_ENET1_TX_DATA0__ENET1_TDATA00	0x1b0b0
			MX6UL_PAD_ENET1_TX_DATA1__ENET1_TDATA01	0x1b0b0
			MX6UL_PAD_ENET1_TX_CLK__ENET1_REF_CLK1	0x4001b031
		>;
	};

	pinctrl_enet2: enet2grp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO07__ENET2_MDC		0x1b0b0
			MX6UL_PAD_GPIO1_IO06__ENET2_MDIO	0x1b0b0
			MX6UL_PAD_ENET2_RX_EN__ENET2_RX_EN	0x1b0b0
			MX6UL_PAD_ENET2_RX_ER__ENET2_RX_ER	0x1b0b0
			MX6UL_PAD_ENET2_RX_DATA0__ENET2_RDATA00	0x1b0b0
			MX6UL_PAD_ENET2_RX_DATA1__ENET2_RDATA01	0x1b0b0
			MX6UL_PAD_ENET2_TX_EN__ENET2_TX_EN	0x1b0b0
			MX6UL_PAD_ENET2_TX_DATA0__ENET2_TDATA00	0x1b0b0
			MX6UL_PAD_ENET2_TX_DATA1__ENET2_TDATA01	0x1b0b0
			MX6UL_PAD_ENET2_TX_CLK__ENET2_REF_CLK2	0x4001b031
		>;
	};

	pinctrl_i2c1: i2c1grp {
		fsl,pins = <
			MX6UL_PAD_UART4_TX_DATA__I2C1_SCL 0x4001b8b0
			MX6UL_PAD_UART4_RX_DATA__I2C1_SDA 0x4001b8b0
		>;
	};

	pinctrl_peri_3v3: peri3v3grp {
		fsl,pins = <
			MX6UL_PAD_SNVS_TAMPER2__GPIO5_IO02	0x1b0b0
		>;
	};

	pinctrl_uart1: uart1grp {
		fsl,pins = <
			MX6UL_PAD_UART1_TX_DATA__UART1_DCE_TX 0x1b0b1
			MX6UL_PAD_UART1_RX_DATA__UART1_DCE_RX 0x1b0b1
		>;
	};

	pinctrl_uart2: uart2grp {
		fsl,pins = <
			MX6UL_PAD_UART2_TX_DATA__UART2_DCE_TX	0x1b0b1
			MX6UL_PAD_UART2_RX_DATA__UART2_DCE_RX	0x1b0b1
			MX6UL_PAD_UART3_RX_DATA__UART2_DCE_RTS	0x1b0b1
			MX6UL_PAD_UART3_TX_DATA__UART2_DCE_CTS	0x1b0b1
		>;
	};

	pinctrl_usdhc2: usdhc2grp {
		fsl,pins = <
			MX6UL_PAD_NAND_RE_B__USDHC2_CLK     0x17059
			MX6UL_PAD_NAND_WE_B__USDHC2_CMD     0x17059
			MX6UL_PAD_NAND_DATA00__USDHC2_DATA0 0x17059
			MX6UL_PAD_NAND_DATA01__USDHC2_DATA1 0x17059
			MX6UL_PAD_NAND_DATA02__USDHC2_DATA2 0x17059
			MX6UL_PAD_NAND_DATA03__USDHC2_DATA3 0x17059
		>;
	};

	pinctrl_wdog: wdoggrp {
		fsl,pins = <
			MX6UL_PAD_LCD_RESET__WDOG1_WDOG_ANY    0x30b0
		>;
	};
};
