[Unit]
Description=Grow root partition and filesystem to fill available eMMC storage
DefaultDependencies=no
After=systemd-remount-fs.service
Before=sysinit.target
ConditionPathExists=!/var/lib/swr-rootfs-resized

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/swr-rootfs-resize.sh
StandardOutput=journal+console

[Install]
WantedBy=sysinit.target
